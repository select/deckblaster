[[keys]]
  index = 0
  [keys.widget]
    id = "button"
    [keys.widget.config]
      icon = "polymarket/assets/polymarket-icon.png"
  [keys.action]
    exec = "uv run decks/polymarket/polymarket.py init"
    deck = "polymarket/polymarket.deck"

[[keys]]
  index = 1
  [keys.widget]
    id = "button"
    [keys.widget.config]
      icon = "highlight/assets/highlight-icon.png"
  [keys.action]
    deck = "highlight/highlight.deck"

[[keys]]
  index = 2
  [keys.widget]
    id = "button"
    [keys.widget.config]
      icon = "ha/assets/ha.png"
  [keys.action]
    deck = "ha/ha.deck"

[[keys]]
  index = 3
  [keys.widget]
    id = "button"
    [keys.widget.config]
      icon = "assets/apps.png"
  [keys.action]
    deck = "apps.deck"

[[keys]]
  index = 4
  [keys.widget]
    id = "time"
    [keys.widget.config]
      format = "%H:%i;%d %M"
      font = "bold;regular"
  [keys.action]
    deck = "calendar/calendar.deck"

[[keys]]
  index = 5
  [keys.widget]
    id = "top"
    [keys.widget.config]
      mode = "memory"
      fillColor = "#d497de"

[[keys]]
  index = 6
  [keys.widget]
    id = "command"
    interval = 30000
    [keys.widget.config]
      icon_command = "bun decks/github/github-prs.js badge"
      command = ""
  [keys.action]
    deck = "github/github.deck"

# Docker button
[[keys]]
  index = 7
  [keys.widget]
    id = "command"
    interval = 5000
    [keys.widget.config]
      icon_command = "bun decks/docker/docker-render.js badge"
      command = ""
  [keys.action]
    deck = "docker/docker.deck"

[[keys]]
  index = 8
  [keys.widget]
    id = "command"
    interval = 5000
    [keys.widget.config]
      icon_command = "bun decks/ports/ports-render.js badge"
      command = ""
  [keys.action]
    deck = "ports/ports.deck"

[[keys]]
  index = 9
  [keys.widget]
    id = "command"
    interval = 5000
    [keys.widget.config]
      icon_command = "bun decks/calendar/next-event.js icon"
      command = ""
  [keys.action]
    exec = "bun decks/calendar/next-event.js open"

[[keys]]
  index = 10
  [keys.widget]
    id = "command"
    interval = 3000
    [keys.widget.config]
      icon_command = "echo /tmp/streamdeck-vdesktop/desk-0.png"
      command = ""
  [keys.action]
    exec = "python3 decks/vdesktop/vdesktop-render.py switch 0"

[[keys]]
  index = 11
  [keys.widget]
    id = "command"
    interval = 3000
    [keys.widget.config]
      icon_command = "echo /tmp/streamdeck-vdesktop/desk-1.png"
      command = ""
  [keys.action]
    exec = "python3 decks/vdesktop/vdesktop-render.py switch 1"

[[keys]]
  index = 12
  [keys.widget]
    id = "command"
    interval = 3000
    [keys.widget.config]
      icon_command = "echo /tmp/streamdeck-vdesktop/desk-2.png"
      command = ""
  [keys.action]
    exec = "python3 decks/vdesktop/vdesktop-render.py switch 2"

[[keys]]
  index = 13
  [keys.widget]
    id = "command"
    interval = 3000
    [keys.widget.config]
      icon_command = "echo /tmp/streamdeck-vdesktop/desk-3.png"
      command = ""
  [keys.action]
    exec = "python3 decks/vdesktop/vdesktop-render.py switch 3"

[[keys]]
  index = 14
  [keys.widget]
    id = "command"
    interval = 3000
    [keys.widget.config]
      icon_command = "echo /tmp/streamdeck-vdesktop/desk-4.png"
      command = ""
  [keys.action]
    exec = "python3 decks/vdesktop/vdesktop-render.py switch 4"
