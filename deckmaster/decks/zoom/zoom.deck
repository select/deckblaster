parent = "../apps.deck"

# 0 — Mute / Unmute
[[keys]]
  index = 0
  [keys.widget]
    id = "command"
    interval = 3000
    [keys.widget.config]
      icon_command = "./deckctl zoom icon mic"
      command = ""
  [keys.action]
    exec = "./deckctl zoom toggle mute"

# 1 — Start / Stop video
[[keys]]
  index = 1
  [keys.widget]
    id = "command"
    interval = 3000
    [keys.widget.config]
      icon_command = "./deckctl zoom icon video"
      command = ""
  [keys.action]
    exec = "./deckctl zoom toggle video"

# 2 — Raise / Lower hand
[[keys]]
  index = 2
  [keys.widget]
    id = "command"
    interval = 3000
    [keys.widget.config]
      icon_command = "./deckctl zoom icon hand"
      command = ""
  [keys.action]
    exec = "./deckctl zoom toggle hand"

# 3 — empty
[[keys]]
  index = 3
  [keys.widget]
    id = "button"
    [keys.widget.config]
      icon = "../assets/empty.png"

# 4 — Leave meeting
[[keys]]
  index = 4
  [keys.widget]
    id = "command"
    interval = 3000
    [keys.widget.config]
      icon_command = "./deckctl zoom icon leave"
      command = ""
  [keys.action]
    exec = "./deckctl zoom leave"

# 5–13 — empty
[[keys]]
  index = 5
  [keys.widget]
    id = "button"
    [keys.widget.config]
      icon = "../assets/empty.png"

