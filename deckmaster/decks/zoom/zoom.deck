parent = "../apps.deck"

# 0 — Mute / Unmute
[[keys]]
  index = 0
  [keys.widget]
    id = "command"
    interval = 3000
    [keys.widget.config]
      icon_command = "python3 decks/zoom/zoom.py icon mic"
      command = ""
  [keys.action]
    exec = "python3 decks/zoom/zoom.py toggle mute"

# 1 — Start / Stop video
[[keys]]
  index = 1
  [keys.widget]
    id = "command"
    interval = 3000
    [keys.widget.config]
      icon_command = "python3 decks/zoom/zoom.py icon video"
      command = ""
  [keys.action]
    exec = "python3 decks/zoom/zoom.py toggle video"

# 2 — Raise / Lower hand
[[keys]]
  index = 2
  [keys.widget]
    id = "command"
    interval = 3000
    [keys.widget.config]
      icon_command = "python3 decks/zoom/zoom.py icon hand"
      command = ""
  [keys.action]
    exec = "python3 decks/zoom/zoom.py toggle hand"

# 3 — empty
[[keys]]
  index = 3
  [keys.widget]
    id = "button"

# 4 — Leave meeting
[[keys]]
  index = 4
  [keys.widget]
    id = "command"
    interval = 3000
    [keys.widget.config]
      icon_command = "python3 decks/zoom/zoom.py icon leave"
      command = ""
  [keys.action]
    exec = "python3 decks/zoom/zoom.py leave"

# 5–13 — empty
[[keys]]
  index = 5
  [keys.widget]
    id = "button"

[[keys]]
  index = 6
  [keys.widget]
    id = "button"

[[keys]]
  index = 7
  [keys.widget]
    id = "button"

[[keys]]
  index = 8
  [keys.widget]
    id = "button"

[[keys]]
  index = 9
  [keys.widget]
    id = "button"

[[keys]]
  index = 10
  [keys.widget]
    id = "button"

[[keys]]
  index = 11
  [keys.widget]
    id = "button"

[[keys]]
  index = 12
  [keys.widget]
    id = "button"

[[keys]]
  index = 13
  [keys.widget]
    id = "button"

# 14 — Back
[[keys]]
  index = 14
  [keys.widget]
    id = "button"
    [keys.widget.config]
      icon = "../assets/back.png"
      label = "Back"
      fontsize = 8
  [keys.action]
    deck = "../main.deck"
