parent ="../main.deck"

# ── Row 0: Lights ──────────────────────────────────────────────────────────────

[[keys]]
  index = 0
  [keys.widget]
    id ="command"
    interval = 5000
    [keys.widget.config]
      icon_command = "python3 decks/ha/ha.py icon-light switch.blaues_zimmer_schrank desk"
      command ="echo Buero"
      font ="regular"
      color ="#3399ff"
  [keys.action]
    exec = "python3 decks/ha/ha.py toggle-switch switch.blaues_zimmer_schrank"

[[keys]]
  index = 1
  [keys.widget]
    id ="command"
    interval = 5000
    [keys.widget.config]
      icon_command = "python3 decks/ha/ha.py icon-light light.esstisch sofa"
      command ="echo Esstisch"
      font ="regular"
      color ="#ff9900"
  [keys.action]
    exec = "python3 decks/ha/ha.py toggle-light light.esstisch"

[[keys]]
  index = 2
  [keys.widget]
    id ="command"
    interval = 5000
    [keys.widget.config]
      icon_command = "python3 decks/ha/ha.py icon-light light.schlafzimmer_decke bed"
      command ="echo Schlafz."
      font ="regular"
      color ="#cc66ff"
  [keys.action]
    exec = "python3 decks/ha/ha.py toggle-light light.schlafzimmer_decke"

# ── Row 1: Door sensors (keys 3–6) ─────────────────────────────────────────────
# Shows"last opened" time (e.g."4h ago") or"OPEN!" when currently open.
# ha-door-poll.sh (started by start.sh) pushes a 20s red flash to key 7 on
# the main deck whenever any door opens.

[[keys]]
  index = 3
  [keys.widget]
    id ="command"
    interval = 5000
    [keys.widget.config]
      icon_command = "python3 decks/ha/ha.py icon-door binary_sensor.haustur_contact haustur Haustür"
      command =""

[[keys]]
  index = 4
  [keys.widget]
    id ="command"
    interval = 5000
    [keys.widget.config]
      icon_command = "python3 decks/ha/ha.py icon-door binary_sensor.terrassentur_contact terrasse Terrasse"
      command =""

[[keys]]
  index = 5
  [keys.widget]
    id ="command"
    interval = 5000
    [keys.widget.config]
      icon_command = "python3 decks/ha/ha.py icon-door binary_sensor.kuchentur_contact kueche Küche"
      command =""

[[keys]]
  index = 6
  [keys.widget]
    id ="command"
    interval = 5000
    [keys.widget.config]
      icon_command = "python3 decks/ha/ha.py icon-door binary_sensor.fahrrad_box_contact fahrrad Fahrrad"
      command =""
      font ="bold;regular"
      color ="#dddddd;#ffffff"

# ── Row 2: Plant moisture sensors (keys 7–9) ───────────────────────────────────
# Icon colour: orange < 25 % (dry) → green 25–65 % (ok) → blue > 65 % (wet).
# Side bar on icon shows fill level at a glance.

[[keys]]
  index = 7
  [keys.widget]
    id ="command"
    interval = 30000
    [keys.widget.config]
      icon_command = "python3 decks/ha/ha.py icon-moisture sensor.3rd_soilmoisture_1_soil_moisture_2 soil1 Pflanze 1"
      command =""

[[keys]]
  index = 8
  [keys.widget]
    id ="command"
    interval = 30000
    [keys.widget.config]
      icon_command = "python3 decks/ha/ha.py icon-moisture sensor.3rd_soilmoisture_2_soil_moisture soil2 Pflanze 2"
      command =""

[[keys]]
  index = 9
  [keys.widget]
    id ="command"
    interval = 30000
    [keys.widget.config]
      icon_command = "python3 decks/ha/ha.py icon-moisture sensor.soilmoisture_nila_soil_moisture nila Nila"
      command =""

# ── Remaining keys empty ───────────────────────────────────────────────────────

[[keys]]
  index = 10
  [keys.widget]
    id ="button"

[[keys]]
  index = 11
  [keys.widget]
    id ="button"

[[keys]]
  index = 12
  [keys.widget]
    id ="button"

[[keys]]
  index = 13
  [keys.widget]
    id ="button"

# ── Back ───────────────────────────────────────────────────────────────────────

[[keys]]
  index = 14
  [keys.widget]
    id ="button"
    [keys.widget.config]
      icon ="../assets/back.png"
      label ="Back"
      fontsize = 8
  [keys.action]
    deck ="../main.deck"
