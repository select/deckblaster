parent = "../main.deck"

# ── Jira open issues ──────────────────────────────────────────────────────────
#
# Layout (5×3):
#   [HEAD ] [ISS 0] [ISS 1] [ISS 2] [ISS 3]
#   [ISS 4] [ISS 5] [ISS 6] [ISS 7] [ISS 8]
#   [ISS 9] [ISS10] [ISS11] [empty] [BACK ]
#
# Polling: deck interval = 60 s on all keys.
# The script uses a 2-min TTL for Jira API calls.
# All slot images are pre-rendered in one shot when the cache expires.

# ── Header ─────────────────────────────────────────────────────────────────────
[[keys]]
  index = 0
  [keys.widget]
    id = "command"
    interval = 60000
    [keys.widget.config]
      icon_command = "bun decks/jira/jira-issues.ts header"
      command = ""

# ── Issue slots ────────────────────────────────────────────────────────────────

[[keys]]
  index = 1
  [keys.widget]
    id = "command"
    interval = 60000
    [keys.widget.config]
      icon_command = "bun decks/jira/jira-issues.ts icon 0"
      command = ""
  [keys.action]
    exec = "bun decks/jira/jira-issues.ts url 0"

[[keys]]
  index = 2
  [keys.widget]
    id = "command"
    interval = 60000
    [keys.widget.config]
      icon_command = "bun decks/jira/jira-issues.ts icon 1"
