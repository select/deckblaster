    id = "command"
    interval = 5000
    [keys.widget.config]
      icon_command = "decks/docker/docker-icon.sh 6"
      command = ""
  [keys.action]
    exec = "decks/docker/docker-action.sh toggle 6"

[[keys]]
  index = 8
