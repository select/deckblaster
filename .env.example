# ~/.config/streamdeck.env — local secrets, never committed to git
#
# Copy this file to ~/.config/streamdeck.env and fill in your values.
# The file is sourced by deckmaster/start.sh on every service start.

# Home Assistant
HA_TOKEN=your-long-lived-access-token-here
HA_URL=http://your-ha-ip:8123

# Stream Deck HTTP API (set by deckmaster --api flag; usually no need to change)
DECK_API=http://localhost:9990
